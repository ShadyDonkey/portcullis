[discord]
token="${DISCORD_TOKEN}"
intents = [
    "GUILDS",
    "GUILD_MESSAGES",
    "MESSAGE_CONTENT"
]

[discord.sharding]
#shard_count_override=100 # overrides and disables the internal resharding
reshard_check_interval="24h"

[portcullis]
publish = [
    "MESSAGE_CREATE",
    "MESSAGE_DELETE",
    # "*" # all events retrived to be published
]
#state_path="data/state.db"

[bridges.webhook]
enabled=false
url="${WEBHOOK_URL}"
#event_in_path=false # true posts to url/EVENT_NAME instead of url
#fire_and_forget=false # true ignores the response: no retries, no logging
#max_retries=3 # repeats on 429 or when the receiver cannot be reached


[bridges.webhook.auth]
#key="${WEBHOOK_KEY}" # no key disables auth
#header="X-API-Key"

[bridges.jetstream]
enabled=false
url="${NATS_URL}"
username="${NATS_USERNAME}"
password="${NATS_PASSWORD}"
#connection_name="portcullis" # optional, defaults to portcullis for monitoring?

[bridges.jetstream.stream]
#name="DISCORD_EVENTS" # optional
#subject_prefix="events" # optional
#max_age="24h" # optional
#max_bytes="1GB" # optional

[http]
enabled=false
listen=":3333"

[http.auth]
key="${HTTP_AUTH_KEY}"
#header="X-API-Key" # optional, override the default pattern

[http.healthz]
require_auth=true
show_stats=false

[observability] # defaults to everything disabled
# Everything is fed from standard OTEL_* env vars
otel_enabled=false
# Fed from SENTRY_* env vars
sentry_enabled=false

# slog configs
[log]
level="info"
format="json" # string for pretty logging in local? mainly for log dumping